# ─────────────────────────────────────────────
#  FirmForge — Environment Variables
#  Copy this file to .env.local and fill in values
#  NEVER commit .env.local to git
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # Server-only, never expose to client

# ── Claude AI ─────────────────────────────────
CLAUDE_API_KEY=sk-ant-...                               # console.anthropic.com → API Keys

# ── GitHub API ────────────────────────────────
GITHUB_DISCOVERY_TOKEN=github_pat_...                   # Bot account token for library search (read-only, public_repo scope only)
                                                        # Use a dedicated firmforge-bot GitHub account — NOT the founder's personal token
                                                        # Pro GitHub push uses the logged-in user's OAuth token (profiles.github_access_token)
GITHUB_OAUTH_CLIENT_ID=                                 # GitHub OAuth App (for Pro user GitHub push)
GITHUB_OAUTH_CLIENT_SECRET=                             # GitHub OAuth App secret

# ── Cloudflare R2 ─────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=firmforge-outputs
CLOUDFLARE_R2_PUBLIC_URL=https://outputs.firmforge.dev  # Public URL for R2 bucket

# ── Paddle Billing ────────────────────────────
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_VENDOR_ID=                           # Same as PADDLE_VENDOR_ID, safe for client

# ── Monitoring ────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Component Pricing APIs ────────────────────
LCSC_API_KEY=                                           # lcsc.com developer portal
MOUSER_API_KEY=                                         # mouser.com/api-hub

# ── App Config ────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000               # Change to https://firmforge.dev in production
NODE_ENV=development
